<% layout('layout/layout.ejs') -%>
<body>
    <div class="row col-8 mx-auto">
    <form method="post" action="/listing/<%= element.id %>?_method=PUT" class="edit&newForm needs-validation" novalidate>
        <div>
            <label for="title">Title</label>
            <input type="text" value="<%= element.title %>" name="list[title]" id="title" class="form-control"> 
        </div>
       <div>
        <label for="text">Add Description</label>
        <textarea name="list[description]" id="text" class="form-control" required><%= element.description %></textarea>
       </div>
       <div>
        <label for="price">Price</label>
        <input type="text" value="<%= element.price %>" name="list[price]" placeholder="Price" class="form-control" id="price" required>
       </div>
        <div>
        <label for="location">Location</label>
        <input type="text" value="<%= element.location %>" name="list[location]" placeholder="Location" class="form-control" id="location" required>

       </div> 
       <div>
        <label for="img">Image</label>
        <input type="text" value="<%= element.image %>" name="list[image]" placeholder="Image URL" class="form-control" id="img" required>
       </div> 
       <div>
        <label for="country">Country</label>
        <input type="text" value="<%= element.country %>" name="list[country]" class="form-control" id="country" required>
       </div>
        <button type="submit" class="delete">Submit</button>
    </form>
</div>
</body>


