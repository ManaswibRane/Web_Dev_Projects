
<% layout('layout/layout.ejs') -%>
<body>
    <div class="showcont">
        <h3><%=list.title %> </h3>
        <ul>
            <li><%=list.title %></li>
            <li><%=list.description %></li>
            <li>&#8377;<%=list.price.toLocaleString('en-IN') %></li>
            <li><%=list.location %></li>
            <li><%=list.country %></li>
            <li><img src="<%=list.image %>" alt="" class="showImg"></li>
            <div class="buttons">
                <a href="http://localhost:8080/listing/<%= list.id %>/edit">Edit</a>
                <form action="/listing/<%=list.id%>?_method=DELETE" method="post">
                    <button type="submit" class="delete">Delete</button>
                </form>
            </div>
           
        </ul>
    </div>
   
</body>
